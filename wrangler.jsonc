{
  // Cloudflare Workers settings for the photo app.
  "name": "photos",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // Website files. Cloudflare serves these directly; only /api and /img reach worker.js.
  "assets": { "directory": "./public" },
  // Your R2 bucket. If you named it something other than "photos", change bucket_name.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "photos" }],
  // Keep settings you add in the dashboard when the site redeploys.
  "keep_vars": true,
  "observability": { "enabled": true }
}
